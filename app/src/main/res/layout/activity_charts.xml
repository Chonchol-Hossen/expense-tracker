<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chart_bg">

    <!-- Chart Type Spinner -->
    <Spinner
        android:id="@+id/chartTypeSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/spinner_bg"
        android:padding="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Charts -->
    <LinearLayout
        android:id="@+id/chartContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chartTypeSpinner">

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/expensePieChart"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1" />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/incomePieChart"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Expense / Income Toggle -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/typeToggleGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:checkedButton="@+id/btnToggleExpense"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chartContainer">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleExpense"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:checked="true"
            android:fontFamily="@font/inter_medium"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Expense"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:backgroundTint="@color/light_grey"
            android:textSize="14sp"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleIncome"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:fontFamily="@font/inter_medium"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Income"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:backgroundTint="@color/light_grey"
            android:textSize="14sp"
            app:strokeWidth="0dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- ✅ Set Budget Text -->

    <!-- Category List -->

    <TextView
        android:id="@+id/tvSetBudget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter_medium"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:text="Set Budget"
        android:textColor="@color/primary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chartContainer" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tvSetBudget"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/categoryCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp" />
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="312dp"
        android:layout_height="68dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bottom_nav_background"
        android:padding="5dp"
        app:elevation="12dp"
        app:itemIconSize="24dp"
        app:itemIconTint="@drawable/bottom_nav_item_color"
        app:labelVisibilityMode="unlabeled"
        app:itemActiveIndicatorStyle="@style/BottomNav.ActiveIndicator.None"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
