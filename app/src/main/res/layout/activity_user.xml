<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg"
    tools:context=".UserActivity">

    <!-- Top bar -->
    <TextView
        android:id="@+id/editTextTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:text="User Settings"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#1A131313"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextTitle" />

    <!-- Scrollable content behind the floating nav -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="120dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Profile image -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profileImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_camera"
                app:civ_border_color="@color/button_green"
                app:civ_border_width="0dp" />

            <!-- Profile name and email section -->
            <TextView
                android:id="@+id/textName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter_semibold"
                android:text="John Doe"
                android:textColor="@color/black"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/textEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:fontFamily="@font/inter"
                android:text="john@example.com"
                android:textColor="@color/grey"
                android:textSize="14sp" />

            <!-- Cards container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:padding="0dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sectionAccount"
                    android:insetTop="0dp"
                    android:insetBottom="4dp"
                    android:minHeight="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center_vertical|start"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Account Settings"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="#99FAFAFA" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sectionCategories"
                    android:insetTop="0dp"
                    android:insetBottom="4dp"
                    android:minHeight="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center_vertical|start"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Categories"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:backgroundTint="#99FAFAFA"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sectionWallets"
                    android:insetTop="0dp"
                    android:insetBottom="4dp"
                    android:minHeight="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center_vertical|start"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Wallets"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="#99FAFAFA" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sectionSupport"
                    android:insetTop="0dp"
                    android:insetBottom="4dp"
                    android:minHeight="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center_vertical|start"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Contact Support"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="#99FAFAFA" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSignOut"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/button_red"
                android:fontFamily="@font/inter_medium"
                android:text="Sign Out"
                android:textColor="@color/white"
                app:cornerRadius="10dp"
                android:textSize="14sp"/>

        </LinearLayout>

    </ScrollView>

    <!-- Floating Bottom Navigation OVER the content -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="312dp"
        android:layout_height="68dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bottom_nav_background"
        android:padding="5dp"
        app:elevation="12dp"
        app:itemActiveIndicatorStyle="@style/BottomNav.ActiveIndicator.None"
        app:itemIconSize="24dp"
        app:itemIconTint="@drawable/bottom_nav_item_color"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
