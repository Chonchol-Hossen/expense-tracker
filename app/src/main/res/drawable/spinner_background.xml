<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/light_grey" /> <!-- semi-transparent pressed color -->
            <corners android:radius="8dp" />
            <stroke android:width="0dp" android:color="@color/black" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/light_grey" /> <!-- semi-transparent focused color -->
            <corners android:radius="8dp" />
            <text android:color="@color/black" />
            <stroke android:width="0dp" android:color="@color/black" />
        </shape>
    </item>

    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" /> <!-- Light gray background for selected item -->
            <corners android:radius="8dp" />
            <stroke android:width="0dp" android:color="@color/black" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" /> <!-- Light background for default state -->
            <corners android:radius="8dp" />
            <stroke android:width="0.5dp" android:color="@color/grey_50" />
        </shape>
    </item>

</selector>